{
  "extends": "@tsconfig/node22/tsconfig.json",
  "compilerOptions": {
    "baseUrl": ".",

    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",

    "declaration": true,
    "emitDeclarationOnly": false,
    "skipLibCheck": true,

    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,

    "strict": true,
    "isolatedModules": true,
    "noEmitOnError": false,

    "jsx": "preserve",
    "jsxImportSource": "vue",

    "types": ["node"]
  }
}
