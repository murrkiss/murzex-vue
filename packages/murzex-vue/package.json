{
	"name": "@murzex-vue/mvue",
	"version": "1.0.0",
	"description": "Murzex vue - UI Kit",
	"author": {
		"name": "murrkiss"
	},
	"license": "MIT",
	"homepage": "https://github.com/murrkiss/murzex-vue",
	"repository": {
		"type": "git",
		"url": "https://github.com/murrkiss/murzex-vue.git"
	},
	"bugs": {
		"url": "https://github.com/murrkiss/murzex-vue/issues"
	},
	"publishAccess": {
		"access": "public"
	},
	"engines": {
		"node": ">=12.11.0"
	},
	"main": "./dist/index.umd.js",
	"module": "./dist/index.es.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"main": "./dist/index.umd.js",
			"module": "./dist/index.es.js",
			"types": "./dist/index.d.ts"
		},
		"./style": "./dist/mvue.css"
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "NODE_ENV=production pnpm run type-check && pnpm run build:js",
		"dev": "pnpm run type-check && pnpm run build:watch",

		"build:js": "vite build --",
		"build:watch": "vite build --watch",

		"type-check": "vue-tsc --noEmit"
	},
	"peerDependencies": {
		"vue": "^3.5.0"
	},
	"peerDependenciesMeta": {
		"vue": {
			"optional": true
		}
	}
}
